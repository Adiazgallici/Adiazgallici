{
  "name": "adiazgallici",
  "private": true,
  "description": "GitHub profile README, the adiazgallici.dev site and the tools that render the profile images.",
  "scripts": {
    "setup": "npm --prefix apps/web ci && python3 -m venv tools/profile-art/.venv && tools/profile-art/.venv/bin/pip install -q pillow",
    "dev": "npm --prefix apps/web run dev",
    "build": "npm --prefix apps/web run build",
    "start": "npm --prefix apps/web run start",
    "typecheck": "npm --prefix apps/web run typecheck",
    "profile:banner": "node tools/profile-art/render-gif-frames.cjs && tools/profile-art/.venv/bin/python -I tools/profile-art/make-gif.py tools/profile-art",
    "profile:cards": "node tools/profile-art/capture-cards.cjs && node tools/profile-art/capture-system.cjs",
    "profile:export": "tools/profile-art/.venv/bin/python -I tools/profile-art/export-assets.py"
  }
}
